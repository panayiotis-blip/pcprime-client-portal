VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key (public) for the /signup captcha.
# Optional — the signup form works without it; set it (and the
# TURNSTILE_SECRET_KEY Edge Function secret in Supabase) to enable the captcha.
# Get both from dash.cloudflare.com → Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Sentry error tracking (optional). Set this in Vercel to turn it on; the SDK
# stays silent without it and is disabled in local dev. Get it from
# sentry.io → your project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
