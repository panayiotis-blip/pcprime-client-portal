Greson_Property_Rentals.html
SEED_greson_rental.sql
SEED_greson_live.sql

# Client management app (real client data — data goes to Supabase, not git)
Greson_Management_Dashboard.html
greson_mgmt_live.json
greson_mgmt_clean.json
SEED_greson_mgmt.sql

# Client payroll app (real employee data — seed goes to Supabase, not git)
km-payroll-app.html
SEED_km_payroll.sql
km-payroll-data.json

# Supabase CLI local state (project link, not shared)
supabase/.temp/

# Credentials kept in a scratch file — passwords and host-verification tokens
All Apps Notes and Users etc..txt

# Greson working data, alongside the greson_mgmt_* rules above
greson_*.json

# Client documents and working spreadsheets dropped at the repo root.
# Tax returns, chart-of-accounts exports, import sheets, engagement docs —
# all real client data. Root only, so nothing under src/, docs/ or supabase/
# is affected. Use `git add -f` if a specific one genuinely belongs in git.
/*.pdf
/*.xls
/*.xlsx
/*.docx
/*.zip
/*.txt

# Task briefs, prompts and session notes written for a single piece of work.
# Kept locally so `git status` stays readable — the durable docs live in
# docs/, and future-roadmap.md / backlog-review-*.md remain tracked.
/task-*.md
/claude-code-prompt*.md
/response-*.md
/full-status-check*.md
/session-handoff-*.md
/engagement-letter-*.md

# Local storage backups (scripts/backup-storage.mjs) — client documents, never commit
backups/

# Client figures dropped here for import (Soft1 TB exports, payroll journals…).
# Real financial data — never commit.
imports/

# Client management reporting app (Baron Air Ltd's real ledger is embedded in
# it — the app goes to Supabase as a template, the figures never to git)
baron-mgmt-reporting.html

# The reporting prototype carries two clients' complete ledgers as embedded
# JSON (A&F and Gerondas). It is the specification, and docs/reporting/BUILD.md
# describes it, but the figures themselves stay out of git like every other
# client dataset here. Keep the file locally; it is not reproducible from the repo.
docs/reporting/prototype.html
template-app.built_5.html

# public/reporting-template.html is deliberately NOT ignored. It is the
# template the reporting build reads and writes a client's data into, so it
# has to ship with the application — ignored, the deployed app has nothing to
# build against. It is a copy of template-app.built_5.html above, which stays
# ignored as the working original.
#
# Built reports are per client and per moment, and belong nowhere near git.
public/built-*.html
