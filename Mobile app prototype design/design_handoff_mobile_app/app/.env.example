# The same Supabase project the web portal uses. Both values are public — they
# ship in the portal's browser bundle too — and row-level security is what
# protects the data. Copy them from the portal's own .env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
