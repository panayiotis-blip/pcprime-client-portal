# Credentials for the scripts under ./scripts/ (admin / diagnostic ops).
# Copy this file to `.env.scripts` and fill in the values.
# `.env.scripts` is gitignored (matches the `.env.*` rule in .gitignore).

SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# Optional overrides — by default the scripts read VITE_SUPABASE_URL /
# VITE_SUPABASE_PUBLISHABLE_KEY from .env. Set these only if you need a
# different project for scripts (e.g. staging vs. local).
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Storage backup script (scripts/backup-storage.mjs) needs the SERVICE ROLE key —
# the publishable key cannot see the objects and would produce an empty backup.
# Full bypass-everything credential: keep it here, never commit, never paste it
# anywhere. Dashboard → Settings → API → service_role.
# SUPABASE_SERVICE_ROLE_KEY=
